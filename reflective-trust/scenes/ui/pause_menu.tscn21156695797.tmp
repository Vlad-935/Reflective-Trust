[sub_resource type="GDScript" id="GDScript_odiyu"]
script/source = "extends HSlider

func _ready() -> void:
	value = AudioManager.master_volume

func _on_value_changed(sound_value: float) -> void:
	Settings.set_master_volume(sound_value)
"

